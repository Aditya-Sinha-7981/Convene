# Operator-only credentials for scripts/update_dns.py. Copy to .env, fill locally, and never commit .env.
CONVENE_DOMAIN=convene.example.com
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-zone-dns-edit-token
CLOUDFLARE_ZONE_ID=replace-with-the-zone-id
CLOUDFLARE_DNS_RECORD_NAME=convene.example.com
TLS_CERT_PATH=/absolute/path/outside-the-repository/fullchain.pem
TLS_KEY_PATH=/absolute/path/outside-the-repository/privkey.pem
