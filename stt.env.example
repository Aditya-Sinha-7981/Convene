# Speech-to-text backend for scripts/start_demo.sh. Copy to stt.env (gitignored by *.env) and fill locally.
# Kept apart from .env on purpose: .env holds DNS credentials that must never reach the server process.
# Never commit a real key.

# "local" (default: mlx-whisper, offline) or "gemini" (demo-only cloud connector, ADR-31).
CONVENE_STT=local

# Needed only when CONVENE_STT=gemini.
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-2.5-flash
# Parallel STT requests in cloud mode (1-16, default 4).
# CONVENE_STT_WORKERS=4
